!focuslock
Track4

Variable activeTrack trackNumber

if modemute == 1
    set muteMode continue
    if InPause == true
        for *
            if trackNumber != activeTrack
                MuteOn
            else
                MuteOff
            endif
        next
    else
        if trackNumber == activeTrack
            if mode == play
                MuteOn
            elseif mode == mute
                MuteOff
            endif
        endif
    endif

else
    if recordingTrack > 0 and recordingTrack != activeTrack
        Track recordingTrack
        Play
    endif

    Track activeTrack

    if mode == reset
        Record
        recordingTrack = activeTrack
        message Recording
    elseif mode == record
        Play
        recordingTrack = 0
        message Play Mode
    elseif mode == play
        Overdub
        message Overdub Mode
    elseif mode == overdub
        Play
        message Play Mode
    endif

    for *
        if trackNumber != activeTrack
            Play
        endif
    next
endif
