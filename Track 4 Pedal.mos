!focuslock
Track4

Variable activeTrack trackNumber

if modemute == 1
    set muteMode continue
    if InPause == true
        for *
            if trackNumber != activeTrack
                MuteOn
            else
                MuteOff
            endif
        next
    else
        if trackNumber == activeTrack
            if mode == play
                MuteOn
            elseif mode == mute
                MuteOff
            endif
        endif
    endif

else
    if track4Clear == false
        Track activeTrack
        message Track Selected
    else
        if recordingTrack > 0 and recordingTrack != activeTrack
            Track recordingTrack
            Play
        endif

        Track activeTrack

        if mode == reset
            Record
            recordingTrack = activeTrack
            track1Clear = true
            message Recording

        elseif mode == record
            Overdub
            for *
                if trackNumber != activeTrack
                    set input 127
                    Play
                endif
            next
            message Overdub Mode

        elseif mode == overdub
            Play
            message Play Mode

        elseif mode == play
            Overdub
            message Overdub Mode
        endif

        for *
            if trackNumber != activeTrack
                Play
            endif
        next
    endif
endif
